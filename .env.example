# Copy this to .env and fill in values — never commit .env itself
DATABASE_URL=sqlite:///./data/vcamon_v2.db
APP_ENV=development
SECRET_KEY=change-me

# FastAPI / Supabase auth scaffold
AUTH_ENABLED=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_AUTH_TIMEOUT_SECONDS=5
SUPABASE_SERVICE_KEY=    # service_role secret — admin only, never expose to frontend
