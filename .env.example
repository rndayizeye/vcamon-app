# Copy this to .env and fill in values — never commit .env itself

# --- Database ---
# Local SQLite (development default):
DATABASE_URL=sqlite:///./data/vcamon_v2.db
# Supabase PostgreSQL (production) — use the Transaction Pooler URL from
# Supabase Dashboard → Project Settings → Database → Connection string:
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

APP_ENV=development
SECRET_KEY=change-me

# --- FastAPI / Supabase auth ---
# Set AUTH_ENABLED=true in production; leave false for local dev without auth
AUTH_ENABLED=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Frontend publishable key (safe to expose to browser):
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_AUTH_TIMEOUT_SECONDS=5
# service_role secret — backend only, never expose to frontend or commit:
SUPABASE_SERVICE_KEY=
# JWT signing secret (Dashboard → Settings → API → JWT Settings). When set, the
# backend verifies access tokens locally (HS256) instead of calling Supabase's
# /auth/v1/user endpoint on every request. Projects using asymmetric signing
# keys (ES256/RS256) can leave this blank — tokens are verified via the JWKS at
# SUPABASE_URL. Only when neither is available does it fall back to the remote
# userinfo lookup. Optional override: SUPABASE_JWT_AUDIENCE (default "authenticated").
SUPABASE_JWT_SECRET=
